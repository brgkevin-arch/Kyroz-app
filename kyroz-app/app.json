{
  "expo": {
    "name": "Kyroz",
    "slug": "kyroz-app",
    "scheme": "kyroz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.kyroz.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "package": "app.kyroz.mobile",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kyroz accède à tes photos pour enregistrer tes photos de progression (elles restent sur ton téléphone).",
          "cameraPermission": "Kyroz utilise l'appareil photo pour tes photos de progression (elles restent sur ton téléphone).",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "baseUrl": "/Kyroz-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28dc4c7e-cace-4fa2-80ba-7b503804d18e"
      }
    },
    "owner": "kevinberger",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/28dc4c7e-cace-4fa2-80ba-7b503804d18e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
