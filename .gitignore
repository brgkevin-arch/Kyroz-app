.DS_Store
node_modules/
# Sans la barre finale AUSSI : un motif terminé par `/` ne matche que les vrais
# répertoires. Dans un worktree, `node_modules` est souvent un LIEN vers celui du
# dépôt principal — git le voit alors comme un fichier, il ressort en `??`, et un
# `git add -A` l'emporte (mesuré le 2026-08-06).
node_modules
.env

# Config Claude Code locale (par machine, chemins absolus, ne doit pas être versionnée)
.claude/settings.local.json

# Source brute Ciqual (ANSES) — 78 Mo, gardée en LOCAL, hors git.
# Elle était committée dans docs/dataverse_files/ alors que kyroz-app/.gitignore
# l'excluait déjà sous Data/Ciqual/ : deux copies sur le disque, une seule utile.
# Ce qui est versionné, c'est le RÉSULTAT de la conversion (lib/foods.generated.ts),
# régénérable par kyroz-app/scripts/convert-ciqual.py.
/Table Ciqual*
docs/Table Ciqual*
docs/dataverse_files/

# Index graphify généré (régénérable via `graphify update .`) — local, hors git
graphify-out/

# Livrables/scratch archivés — local, hors git
/_archive/
